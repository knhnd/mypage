---
import { contactEmail } from "../data/links";
import { localePath, useTranslations, type Lang, type UIKey } from "../i18n";

const { sideBarActiveItemID, lang } = Astro.props as {
  sideBarActiveItemID?: string;
  lang: Lang;
};
const tr = useTranslations(lang);
const activeClass = "bg-base-300";

// id は各ページの sideBarActiveItemID と一致させる
const items: { id: string; slug: string; label: UIKey }[] = [
  { id: "home", slug: "", label: "nav.home" },
  { id: "about", slug: "about", label: "nav.about" },
  { id: "projects", slug: "projects", label: "nav.projects" },
  { id: "publications", slug: "publications", label: "nav.publications" },
  { id: "lectures", slug: "lectures", label: "nav.lectures" },
  { id: "others", slug: "others", label: "nav.others" },
];
---

<ul class="menu w-full grow shrink menu-md overflow-y-auto">
  {
    items.map((item) => (
      <li>
        <a
          class:list={["py-3 text-base", { [activeClass]: item.id === sideBarActiveItemID }]}
          id={item.id}
          href={localePath(lang, item.slug)}
        >
          {tr(item.label)}
        </a>
      </li>
    ))
  }
  <li>
    <a
      class="py-3 text-base"
      href={`mailto:${contactEmail}`}
      target="_blank"
      referrerpolicy="no-referrer-when-downgrade"
    >
      {tr("nav.contact")}
    </a>
  </li>
</ul>
