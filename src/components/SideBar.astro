---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import defaultImg from "../../public/icon.webp";
import profileImg from "../../public/profile.webp";
import SideBarMenu from "./SideBarMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";
import { localePath, type Lang } from "../i18n";
const { sideBarActiveItemID, lang } = Astro.props as { sideBarActiveItemID?: string; lang: Lang };
const isProfilePage = sideBarActiveItemID === "about"; // About ページではプロフィール写真を表示
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside
    class="relative px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col"
  >
    <!-- PC 表示ではここに切り替えボタン（スマホはヘッダー側） -->
    <div class="hidden lg:flex absolute top-2 right-2 z-10 gap-1 items-center">
      <LangToggle lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
    <div class="w-fit mx-auto mt-10 mb-6">
      <a href={localePath(lang)}>
        <div
          class="avatar transition ease-in-out hover:scale-[102%] block m-auto"
        >
          <div class="w-[9.5rem]">
            <Image
              class="mask mask-circle"
              format="webp"
              width={350}
              height={350}
              src={isProfilePage ? profileImg : defaultImg}
              alt="Profile image"
            />
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} lang={lang} />
    <SideBarFooter />
  </aside>
</div>
