---
import type { TimelineItem } from "../data/types";
import { formatPeriod, formatYM, t, type Lang } from "../i18n";

interface Props {
  item: TimelineItem;
  lang: Lang;
}

const { item, lang } = Astro.props;

const title = [item.icon, t(item.title, lang)].filter(Boolean).join(" ");
const subtitle = t(item.subtitle, lang);

// 期間（予定のものは「YYYY年M月開始予定」）
let period: string | undefined;
if (item.start) {
  period = item.planned
    ? lang === "ja"
      ? `${formatYM(item.start, lang)}開始予定`
      : `Starting ${formatYM(item.start, lang)}`
    : formatPeriod(item.start, item.end, lang);
}
const place = t(item.place, lang);
const dateLine = [period, place].filter(Boolean).join(lang === "ja" ? "・" : ", ");
const linkName = t(item.linkName, lang);
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span
      class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"
    ></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <h3 class="font-semibold mb-1">{title}</h3>
    {subtitle && <><span class="font-light text-sm">{subtitle}</span><br /></>}
    {dateLine && <><span class="font-light text-sm">{dateLine}</span><br /></>}
    {
      item.url && (
        <span class="font-light text-sm">
          <a href={item.url} target="_blank" rel="noopener">
            {linkName ?? item.url}
          </a>
        </span>
      )
    }
    <p class="my-2 text-justify">
      <slot />
    </p>
  </div>
</div>
