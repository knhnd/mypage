---
// データは src/data/publications.ts を編集してください
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationSection from "../components/PublicationSection.astro";
import {
  journals,
  internationalConferences,
  domesticPresentations,
} from "../data/publications";
---

<BaseLayout title="Ken HONDA Webpage" sideBarActiveItemID="publications">
  <div>
    <div class="text-4xl w-full font-bold mb-5">Publications</div>
  </div>
  <br /><br /><br />

  <PublicationSection heading="Journals" items={journals} />
  <PublicationSection
    heading="International Conference"
    items={internationalConferences}
  />
  <PublicationSection heading="学会発表" items={domesticPresentations} />
</BaseLayout>
