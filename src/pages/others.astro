---
// データは src/data/links.ts を編集してください
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
---

<BaseLayout title="Ken HONDA Webpage" sideBarActiveItemID="others">
  <div>
    <div class="text-4xl w-full font-bold mb-5">Others</div>
  </div>
  <br /><br /><br />

  <div>
    <div class="text-2xl w-full font-bold mb-4">Links</div>
  </div>
  <div class="divider my-0"></div>
  <div class="time-line-container mb-10">
    <ul>
      {
        links.map((link) => (
          <li>
            <a class="py-3 text-base" href={link.url} target="_blank" rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <br />
</BaseLayout>
