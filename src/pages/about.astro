---
// データは src/data/career.ts を編集してください
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/TimeLine.astro";
import {
  profileText,
  experience,
  academicContributions,
  education,
} from "../data/career";

const sections = [
  { heading: "Experience", items: experience },
  { heading: "Academic Contributions", items: academicContributions },
  { heading: "Education", items: education },
];
---

<BaseLayout title="Ken HONDA Webpage" sideBarActiveItemID="about">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">{profileText}</div>

  {
    sections.map((s) => (
      <>
        <div class="mb-5">
          <div class="text-3xl w-full font-bold">{s.heading}</div>
        </div>
        <div class="time-line-container mb-10">
          {s.items.map((item) => (
            <TimeLineElement {...item} />
          ))}
        </div>
      </>
    ))
  }
</BaseLayout>
