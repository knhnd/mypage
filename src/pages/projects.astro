---
// データは src/data/projects.ts を編集してください
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout title="Ken HONDA Webpage" sideBarActiveItemID="projects">
  <div>
    <div class="text-4xl w-full font-bold mb-5">Projects (Research Funding)</div>
  </div>

  {
    projects.map((p) => (
      <HorizontalCard
        title={p.title}
        img={p.img ? `${basePath}${p.img}` : undefined}
        desc={p.desc}
        url={p.url ?? "#"}
        badge={p.badge}
      />
    ))
  }
</BaseLayout>
