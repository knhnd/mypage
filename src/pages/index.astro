---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
const basePath = import.meta.env.BASE_URL;
// projects.ts で featured: true のものを表示
const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Ken Honda</div>
    <div class="text-3xl py-3 font-bold">Ph.D. (Media Studies)</div>
    <div class="py-2">
      <text class="text-lg">
        Assistant Professor at Faculty of Information Design, Kaishi Innovation University.
      </text><br />
      <text class="text-lg">
        Specialty: Media Informatics, Database Systems, Human Computer
        Interaction.
      </text>
    </div>
  </div>

  <div class="pb-12 mt-5">
    <div class="text-3xl font-bold">本多 賢</div>
    <div class="text-2xl py-3 font-bold">博士（メディア学）</div>
    <div class="py-2">
      <text class="text-lg"> 開志創造大学 情報デザイン学部 助教． </text><br
      />
      <text class="text-lg"> 専門：メディア情報学, データベース, HCI. </text>
    </div>
  </div>

  <div class="pb-12 mt-5">
    <div class="text-2xl py-3 font-bold">Research Themes</div>
    <ul>
      <li>・Media Information Processing</li>
      <li>・Social Computing</li>
      <li>・Digital Social Trust</li>
    </ul>
  </div>

  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-2">Recent Projects</div>
  </div>

  {
    featuredProjects.map((p) => (
      <HorizontalCard
        title={p.title}
        img={p.img ? `${basePath}${p.img}` : undefined}
        desc={p.desc}
        url={`${basePath}projects`}
        target="_self"
      />
    ))
  }
</BaseLayout>
