---
// データは src/data/lectures.ts を編集してください
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/TimeLine.astro";
import { lectureGroups } from "../data/lectures";
---

<BaseLayout title="Ken HONDA Webpage" sideBarActiveItemID="lectures">
  <div>
    <div class="text-4xl w-full font-bold mb-5">Lectures</div>
  </div>
  <br /><br /><br />

  {
    lectureGroups.map((group) => (
      <>
        <div>
          <div class="text-2xl w-full font-bold mb-4">{group.institution}</div>
        </div>
        <div class="divider my-0" />
        <div class="time-line-container mb-10">
          {group.courses.map((course) => (
            <TimeLineElement {...course} />
          ))}
        </div>
        <br />
      </>
    ))
  }
</BaseLayout>
