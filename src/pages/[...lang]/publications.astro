---
// 業績は researchmap（https://researchmap.jp/kenh）から自動生成（src/data/publications.ts）
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationSection from "../../components/PublicationSection.astro";
import {
  conferencePapers,
  domesticPresentations,
  internationalPresentations,
  journals,
  otherPapers,
} from "../../data/publications";
import { langPaths, useTranslations, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const tr = useTranslations(lang);

const sections = [
  { heading: tr("publications.journals"), items: journals },
  { heading: tr("publications.conferencePapers"), items: conferencePapers },
  { heading: tr("publications.otherPapers"), items: otherPapers },
  { heading: tr("publications.internationalPresentations"), items: internationalPresentations },
  { heading: tr("publications.domesticPresentations"), items: domesticPresentations },
];
---

<BaseLayout lang={lang} title={tr("nav.publications")} sideBarActiveItemID="publications">
  <div>
    <div class="text-4xl w-full font-bold mb-5">{tr("publications.title")}</div>
  </div>
  <br /><br /><br />

  {sections.map((s) => <PublicationSection heading={s.heading} items={s.items} lang={lang} />)}
</BaseLayout>
