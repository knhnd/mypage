---
// データは src/data/projects.ts を編集してください
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { projects } from "../../data/projects";
import { langPaths, t, useTranslations, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const tr = useTranslations(lang);
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title={tr("nav.projects")} sideBarActiveItemID="projects">
  <div>
    <div class="text-4xl w-full font-bold mb-5">{tr("projects.title")}</div>
  </div>

  {
    projects.map((p) => (
      <HorizontalCard
        title={t(p.title, lang)}
        img={p.img ? `${basePath}${p.img}` : undefined}
        desc={p.period}
        url={p.url ?? "#"}
        badge={t(p.keywords, lang)}
      />
    ))
  }
</BaseLayout>
