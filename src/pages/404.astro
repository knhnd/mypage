---
// 404 は言語を判別できないため日英併記
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePath, ui } from "../i18n";
---

<BaseLayout lang="ja" title="404: Not Found" includeSidebar={false}>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🏝</h1>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">{ui.ja["404.message"]}</h3>
    <h3 class="text-xl mt-2" lang="en">{ui.en["404.message"]}</h3>
    <div class="mt-9 flex gap-3 justify-center">
      <a class="btn btn-accent" href={localePath("ja")}>{ui.ja["nav.home"]}</a>
      <a class="btn btn-accent" href={localePath("en")} lang="en">{ui.en["nav.home"]}</a>
    </div>
  </div>
</BaseLayout>
